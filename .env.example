# --- Server ---
PORT=8080
SDSHEETAL_DATA=/data

# --- WhatsApp (whatsmeow) ---
# Where the WhatsApp session sqlite lives. Persist this.
WHATSNEW_STORE=/data/whatsmeow.db

# Owner phone number(s) in E.164; ONLY these numbers get replies.
# Separate multiple test/owner numbers with commas, e.g. +919876543210,+919812345678
SD_OWNER_NUMBER=

# Whether to also send ElevenLabs voice notes (audio) with text replies.
SD_VOICE_REPLIES=false
# When true, replies are delivered ONLY as voice notes.
SD_VOICE_NOTE_REPLIES=false

# --- Assistant ---
SDSHEETAL_STATION=Sheetal
SDSHEETAL_TZ=Asia/Kolkata
SD_WELCOME=

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=2JXK0KRt8pLkmUqIPPmmQQ
SDSHEETAL_SPOTIFY_TIMEOUT=6

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=7qBNUtXRGP0jPi0H4r8k
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Sarvam AI (Indic TTS + STT: transcribes your voice notes, voices replies) ---
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANG=hi-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_LANG=unknown
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# --- Nango / Gmail ---
NANGO_SECRET_KEY=
NANGO_API_BASE=https://api.nango.dev
NANGO_INTEGRATION_ID=gmail
NANGO_USER_ID=sheetal

# --- Web panel auth (protect the /api/command tool) ---
SDSHEETAL_AGENT_TOKEN=
