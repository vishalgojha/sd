# Copy to .env and fill in. Any OpenAI-compatible endpoint works.

# --- LLM (optional) -------------------------------------------------------
# Without this the page still works: the whole briefing is scripted.
# Chat replies fall back to a small pool of canned agent-voice quips.
LLM_API_KEY=

# OpenAI / Groq / OpenRouter / Sarvam / Together / Ollama, your pick.
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_PATH=/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400
LLM_TIMEOUT_MS=20000

# Some providers need a second credential header besides the bearer token.
# Sarvam requires BOTH `Authorization` and `api-subscription-key`, so without
# this it answers 403 and the page silently drops back to canned replies.
# Must be a JSON object. Leave blank for providers that do not need it.
LLM_EXTRA_HEADERS=

# --- Sarvam preset ---------------------------------------------------------
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_CHAT_PATH=/chat/completions
# LLM_MODEL=sarvam-105b
# LLM_EXTRA_HEADERS={"api-subscription-key":"sk_your_key_here"}
# Docs: https://docs.sarvam.ai/api-reference/chat/chat-completions-v1

# --- Confirm button (optional) --------------------------------------------
# Her "Friday"/"Saturday" tap turns into a WhatsApp deep link to this number
# with the message pre-filled. Digits only, country code included, no "+".
# Kept out of git on purpose — this repo is public.
NOTIFY_WHATSAPP=

# --- Server ----------------------------------------------------------------
# The server binds every interface on whatever PORT it is given, including when
# PORT is unset. Do not set HOST: a platform-injected HOST is not an address
# this process can bind, and Coolify probes the container over loopback.
PORT=3000

# --- Abuse guard -----------------------------------------------------------
RATE_LIMIT=30
RATE_WINDOW_MS=600000